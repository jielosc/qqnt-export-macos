diff --git a/parser/elements.py b/parser/elements.py
index 7d760e7..35096c3 100644
--- a/parser/elements.py
+++ b/parser/elements.py
@@ -844,4 +844,41 @@ def compute_image_cache_path(
         if path.is_file():
             return path
 
+    # macOS QQ stores pictures as Pic/YYYY-MM/{Ori,Thumb}/<md5>*.ext
+    # instead of the Windows chatraw/chatimg/chatthumb cache layout.
+    if pic_path:
+        matches = _macos_image_index(str(pic_path.resolve())).get(md5.lower())
+        if matches:
+            return matches[0]
+
     return None
+
+
+@lru_cache(maxsize=4)
+def _macos_image_index(pic_path: str) -> dict[str, tuple[Path, ...]]:
+    root = Path(pic_path)
+    indexed: dict[str, list[Path]] = {}
+    try:
+        paths = root.rglob('*')
+        for path in paths:
+            if not path.is_file():
+                continue
+            prefix = path.name[:32].lower()
+            if len(prefix) == 32 and all(char in '0123456789abcdef' for char in prefix):
+                indexed.setdefault(prefix, []).append(path)
+    except OSError:
+        return {}
+
+    def preference(path: Path) -> tuple[int, int, str]:
+        parts = set(path.parts)
+        kind = 0 if 'Ori' in parts else 1 if 'Thumb' in parts else 2
+        try:
+            size = -path.stat().st_size
+        except OSError:
+            size = 0
+        return kind, size, str(path)
+
+    return {
+        digest: tuple(sorted(matches, key=preference))
+        for digest, matches in indexed.items()
+    }
